# Backend
EXPO_PUBLIC_API_URL=https://api.urbanservice.me

# Maps
GOOGLE_MAPS_API_KEY=

# Native Firebase Phone Authentication.
# Download google-services.json for Android package com.giaunh.urbanmind,
# save it in apps/mobile, then point Expo CNG to it with this relative path.
GOOGLE_SERVICES_JSON=./google-services.json

# Optional iOS equivalent when producing an iOS build.
GOOGLE_SERVICE_INFO_PLIST=./GoogleService-Info.plist
